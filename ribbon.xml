            <Button CommandName="cmdNewTab"/>
            <Button CommandName="cmdOpenInExplorer"/>
            <Button CommandName="cmdOpenPS"/>
            <Button CommandName="cmdOpenCmd"/>
          </MenuGroup>
          <MenuGroup Class="MajorItems">
            <Button CommandName="cmdOptions"/>
          </MenuGroup>
          <MenuGroup>
            <Button CommandName="cmdClose"/>
          </MenuGroup>
        </ApplicationMenu>
      </Ribbon.ApplicationMenu>

      <Ribbon.QuickAccessToolbar>
        <QuickAccessToolbar CommandName="cmdQat">
          <QuickAccessToolbar.ApplicationDefaults>
            <Button CommandName="cmdProperties"/>
            <Button CommandName="cmdNewFolder"/>
          </QuickAccessToolbar.ApplicationDefaults>
        </QuickAccessToolbar>
      </Ribbon.QuickAccessToolbar>

