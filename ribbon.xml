                <ControlSizeDefinition ControlName="copy" IsImageVisible="true"  ImageSize="Large" IsLabelVisible="true"/>
                <ControlSizeDefinition ControlName="paste" IsImageVisible="true" ImageSize="Large" IsLabelVisible="true"/>
                <ColumnBreak ShowSeparator="false"/>
                <Row><ControlSizeDefinition ControlName="cut" IsImageVisible="true"  ImageSize="Small" IsLabelVisible="true"/></Row>
                <Row><ControlSizeDefinition ControlName="path" IsImageVisible="true" ImageSize="Small" IsLabelVisible="true"/></Row>
                <Row><ControlSizeDefinition ControlName="link" IsImageVisible="true" ImageSize="Small" IsLabelVisible="true"/></Row>
              </GroupSizeDefinition>
